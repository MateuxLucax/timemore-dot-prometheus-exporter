{
  "uid": "caparao-brews",
  "title": "Caparaó brews",
  "tags": [
    "caparao"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "refresh": "",
  "editable": true,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Brews per day",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (mode) (count_over_time(caparao_brew_yield_grams{mode=~\"$mode\"}[1d]))",
          "legendFormat": "{{mode}}",
          "interval": "1d"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "bars",
            "pointSize": 8,
            "showPoints": "always",
            "spanNulls": false,
            "fillOpacity": 60
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Yield per brew",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (mode) (last_over_time(caparao_brew_yield_grams{mode=~\"$mode\"}[$__interval]))",
          "legendFormat": "yield {{mode}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (mode) (last_over_time(caparao_brew_dose_grams{mode=~\"$mode\"}[$__interval]))",
          "legendFormat": "dose {{mode}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "massg",
          "custom": {
            "drawStyle": "points",
            "pointSize": 8,
            "showPoints": "always",
            "spanNulls": false,
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Ratio per brew (yield / dose)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 7,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (mode) (last_over_time(caparao_brew_ratio{mode=~\"$mode\"}[$__interval]))",
          "legendFormat": "{{mode}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "points",
            "pointSize": 8,
            "showPoints": "always",
            "spanNulls": false,
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Duration per brew",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 7,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (mode) (last_over_time(caparao_brew_duration_seconds{mode=~\"$mode\"}[$__interval]))",
          "legendFormat": "{{mode}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (mode) (last_over_time(caparao_brew_time_to_first_drop_seconds{mode=~\"$mode\"}[$__interval]))",
          "legendFormat": "first drop {{mode}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "points",
            "pointSize": 8,
            "showPoints": "always",
            "spanNulls": false,
            "fillOpacity": 0
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Brew curve: weight",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "caparao_brew_weight_grams{mode=~\"$mode\",id=~\"$id\"}",
          "legendFormat": "{{mode}} {{id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "massg",
          "custom": {
            "drawStyle": "line",
            "pointSize": 8,
            "showPoints": "never",
            "spanNulls": false,
            "fillOpacity": 0,
            "lineInterpolation": "smooth"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Brew curve: flow",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "caparao_brew_flow_grams_per_second{mode=~\"$mode\",id=~\"$id\"}",
          "legendFormat": "{{mode}} {{id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "pointSize": 8,
            "showPoints": "never",
            "spanNulls": false,
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ],
  "description": "Summaries are single points at each brew's end time; the curve panels are best viewed zoomed into one brew (pick it in the id variable or drag-select).",
  "templating": {
    "list": [
      {
        "name": "mode",
        "label": "Mode",
        "type": "custom",
        "query": "espresso,filter",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "id",
        "label": "Brew id",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(caparao_brew_yield_grams{mode=~\"$mode\"}, id)",
          "refId": "id"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 0
      }
    ]
  }
}